# =============================================================================
# SUPABASE CONFIGURATION
# Dapatkan melalui Supabase Dashboard -> Project Settings -> API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Diperlukan sisi server untuk mengirim email Lupa Sandi kustom via SMTP aplikasi:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# APPLICATION URL
# Digunakan untuk resolusi tautan pada notifikasi email dan callback auth
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# EMAIL NOTIFICATION & SMTP CONFIGURATION (Nodemailer)
# =============================================================================
ADMIN_NOTIFICATION_EMAIL=sipardig2026@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sipardig2026@gmail.com
# Gunakan Google Workspace / Gmail App Password (16 karakter tanpa spasi)
# Jika dikosongkan, pengiriman email akan beralih ke mode simulasi (mock)
SMTP_FROM="PPID Digital CIKASDA Sulteng" <sipardig2026@gmail.com>

# =============================================================================
# GOOGLE GEMINI AI CONFIGURATION (Chatbot Si Cika)
# Dapatkan gratis di Google AI Studio (https://aistudio.google.com/app/apikey)
# Jika dikosongkan, chatbot otomatis beralih ke Smart FAQ lokal (0 biaya & 0 error)
# Model Gemini Family 3 yang didukung:
# - gemini-3.5-flash-lite (Rekomendasi default: latensi tercepat, efisiensi token tinggi)
# - gemini-3.5-flash (Model percakapan seimbang)
# - gemini-3.8-flash (Model penalaran tingkat lanjut)
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# =============================================================================
# GOOGLE DRIVE UPLOAD (Pilih salah satu metode berikut):
# =============================================================================
# OPSI A (Paling Mudah & Cepat untuk Gmail Biasa): Google Apps Script Web App
# Cukup 1 URL webhook tanpa perlu setup Google Cloud Console / OAuth Playground
GOOGLE_DRIVE_SCRIPT_URL=
GOOGLE_DRIVE_FOLDER_ID=

# OPSI B (Google Cloud OAuth 2.0 User):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# OPSI C (Google Workspace Service Account):
# GOOGLE_SERVICBUE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=


